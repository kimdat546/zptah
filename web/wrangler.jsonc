// Monoptah web: ONE Worker serving the SPA assets, the Hono /api routes and the
// DesktopRoom Durable Object (architecture.md 4.1). Paths are relative to this file.
// Free tier only: no paid binding is declared. Never deploy from CI or from a sandbox.
{
  "name": "monoptah-web",
  "main": "worker/src/index.ts",
  // nodejs_compat is on by default from 2026-08-04, so no compatibility_flags are listed.
  // Checked against the installed workerd (1.20261117.1): 2026-09-01 is accepted.
  "compatibility_date": "2026-09-01",

  // This self-hosted instance serves one hostname only (the passkey RP ID). No workers.dev or preview URL, so the
  // app has exactly one origin.
  "routes": [{ "pattern": "monoptah.hypercoding.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    // The client output of web/app (`pnpm --filter @monoptah/app build`). It holds `_headers` and no Worker
    // bundle: the Vite build also writes app/dist/monoptah_web (a Worker bundle and its sourcemap), which
    // must never be served as an asset, so this is app/dist/client and not app/dist. For `wrangler dev` and
    // the tests worker/scripts/ensure-assets.mjs creates a git-ignored placeholder when it is absent.
    "directory": "app/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API and the relay run the Worker first, and so do `/` and `/home` (exact paths): the Worker serves the landing
    // page (assets /landing/) to a request without a session cookie and the SPA to one with it (worker/src/landing.ts).
    // Everything else is a free asset request.
    "run_worker_first": ["/api/*", "/relay/*", "/", "/home", "/home/", "/privacy", "/privacy/"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "DesktopRoom" }]
  },
  // SQLite-backed class (the only kind the free plan allows). Forward-only: add a new tag, never edit v1.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DesktopRoom"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monoptah",
      // This self-hosted instance's database (`wrangler d1 create monoptah`, 2026-11-21); `--local` and the
      // tests do not use it.
      "database_id": "8f9cb801-f174-466d-98de-83bada207902",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Encrypted file transfers (modules/transfers): ciphertext only, never public (no custom domain, no public URL, no
  // r2.dev). A lifecycle rule deletes everything under `transfers/` after 1 day; it is bucket configuration, not part of
  // this file: see docs/deploy-runbook.md "File transfer bucket". `wrangler dev` and the tests use a local simulation.
  "r2_buckets": [{ "binding": "TRANSFERS", "bucket_name": "monoptah-transfers" }],

  // Cron intentionally empty on this self-host: the account is limited to 5 crons on the Free plan, so the daily
  // cleanup of worker/src/cron.ts does not run here. Stale `pending` device grants are revoked by hand in the web
  // UI. See ~/.config/monoptah-selfhost/DEPLOY.md. The empty list (not an absent key) removes an existing schedule.
  "triggers": { "crons": [] },

  // Every non-secret setting the program reads. Values of the self-hosted instance monoptah.hypercoding.dev.
  "vars": {
    // RP_ID must never change after the first user registers: every passkey would break.
    "RP_ID": "monoptah.hypercoding.dev",
    "RP_ORIGIN": "https://monoptah.hypercoding.dev",
    // Public half of this instance's VAPID key pair (P-256, base64url, from `pnpm vapid:generate`).
    "VAPID_PUBLIC_KEY": "BGY4O82yoOagEofh8b-c6SYAPB7q5Pclr1hXWLngKx-R5lWMCy6w08L3OIq6rxjTuTvOLVSHFO0gRv_MYBOHdow",
    // Which VAPID key the public key above is (stored in push_subscriptions.vapid_key_id, for rotation).
    "VAPID_KEY_ID": "v1",
    "VAPID_SUBJECT": "https://monoptah.hypercoding.dev",
    // VAPID key rotation only (docs/deploy-runbook.md "VAPID key rotation"): add the OLD public key and its key id
    // here for the rotation period, and the old private key as the secret VAPID_PREVIOUS_PRIVATE_KEY. Never put a
    // key in this file that is not public. Remove all three when the rotation ends. Not set normally:
    //   "VAPID_PREVIOUS_PUBLIC_KEY": "<old public key, base64url>",
    //   "VAPID_PREVIOUS_KEY_ID": "v1",
    // Registered users for the whole instance, incl. blocked. "0" means unlimited (self-host default).
    "MAX_USERS": "5",
    "MAX_DESKTOPS_PER_USER": "5",
    "MAX_DEVICES_PER_USER": "10"
  }

  // Secrets are NEVER in `vars`. Set each with `wrangler secret put <NAME>` (local dev: web/.dev.vars,
  // git-ignored; web/.dev.vars.example lists them with fake values):
  //   VAPID_PRIVATE_KEY  private half of the VAPID key pair (P-256, base64url)
  //   VAPID_PREVIOUS_PRIVATE_KEY  (rotation only) private half of the previous pair, removed when the rotation ends
  //   RECOVERY_PEPPER    HMAC key for recovery code hashes (32 random bytes, base64; back it up)
  //   AUDIT_IP_SALT      salt for the IP hashes in audit_log and pairing_requests (32 random bytes, base64)
}
